# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# --- Supabase (Settings -> API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Xendit (sandbox/test mode keys while we're not live yet) ---
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Only set once a real domain is verified in Resend -- until then,
# sendEmail() falls back to the onboarding@resend.dev test sender.
RESEND_FROM_EMAIL="Adventure Lombok Booking <no-reply@booking.adventure-lombok.com>"

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact info shown to people with no account on this app (e.g. a gift
# voucher recipient told to "contact us"). SUPPORT_EMAIL defaults to
# info@adventure-lombok.com if unset -- override here if that's wrong.
# WHATSAPP_NUMBER is optional and unused (no WhatsApp button/link
# rendered anywhere) until it's set -- digits only, country code first,
# no "+" or spaces, e.g. 6281234567890.
NEXT_PUBLIC_SUPPORT_EMAIL=info@adventure-lombok.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
