# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# --- Supabase (Settings -> API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Xendit (sandbox/test mode keys while we're not live yet) ---
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Only set once a real domain is verified in Resend -- until then,
# sendEmail() falls back to the onboarding@resend.dev test sender.
RESEND_FROM_EMAIL="Adventure Lombok Booking <no-reply@booking.adventure-lombok.com>"

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact info shown to people with no account on this app (e.g. a gift
# voucher recipient told to "contact us"). SUPPORT_EMAIL defaults to
# info@adventure-lombok.com if unset -- override here if that's wrong.
# WHATSAPP_NUMBER is optional and unused (no WhatsApp button/link
# rendered anywhere) until it's set -- digits only, country code first,
# no "+" or spaces, e.g. 6281234567890.
NEXT_PUBLIC_SUPPORT_EMAIL=info@adventure-lombok.com
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social links shown as icons in the site footer -- each one only
# appears once its URL is set here (nothing fabricated, nothing shown
# by default). Full URLs, e.g. https://instagram.com/yourhandle.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- reCAPTCHA (booking/request/gift-purchase forms) ---
# Get both at https://www.google.com/recaptcha/admin (reCAPTCHA v2,
# "I'm not a robot" checkbox). The site key is public and already has
# a real default baked into lib/recaptcha.ts, so this only needs
# setting if it's ever rotated. RECAPTCHA_SECRET_KEY has no default --
# it's a real secret, and reCAPTCHA silently allows every submission
# through (logged, not blocking checkout) until this is set.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
