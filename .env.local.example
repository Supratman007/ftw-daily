# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# --- Supabase (Settings -> API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- WordPress catalog sync (adventure-lombok.com) ---
# Base URL of the WordPress site's REST API, e.g. https://adventure-lombok.com/wp-json
WORDPRESS_API_BASE_URL=
# Shared secret the sync job sends to our WordPress companion plugin so
# only our booking app can call it.
WORDPRESS_SYNC_SECRET=
# Shared secret required to trigger our own /api/cron/sync-catalog route,
# so only Vercel Cron (or us, manually) can run it.
CRON_SECRET=

# --- Xendit (sandbox/test mode keys while we're not live yet) ---
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
