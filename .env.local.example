# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# --- Supabase (Settings -> API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- WordPress catalog sync (adventure-lombok.com) ---
# Base URL of the "Traveler" theme's own REST API on the WordPress site.
# No API key needed -- the read-only catalog routes are public. Optional:
# defaults to this same value in code if left blank.
WORDPRESS_API_BASE_URL=https://adventure-lombok.com/wp-json/traveler
# Shared secret required to trigger our own /api/cron/sync-catalog route
# (and to view /internal/sync-status), so only Vercel Cron -- or us,
# manually, with this value -- can run/view it. Any long random string;
# generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Xendit (sandbox/test mode keys while we're not live yet) ---
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
